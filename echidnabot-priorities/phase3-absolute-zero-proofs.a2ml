statement  = "Suffix-match resolution (the unqualified-name lookup the cross-repo probe and pass-2 wirer both use) is reflexive AND symmetric: matchesBySuffix(s, r) = matchesBySuffix(r, s)."
strategy   = "extend `suffixMatchAgrees` (already in AgdaImporter.idr) with the symmetric direction; Refl after one rewrite."
discharge  = "pending"
buys       = "the cross-repo probe's `a_only / b_only / in_both` partition is invariant under the order of the two import reports — switch report-A and report-B and the buckets swap, nothing else moves."

[[claim]]
id         = "P3-F4-pending"
kind       = "formal"
statement  = "If echo-types and absolute-zero are typechecked under a common Agda library configuration that exposes both, EchoCNOBridge's bridge_fidelity ≥ 0.10 (i.e. at least one shared identifier)."
