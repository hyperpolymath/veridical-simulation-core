# ---- formal claims (discharged) ----

[[claim]]
id         = "P3-F1"
kind       = "formal"
statement  = "Bridge-fidelity numerator (`in_both`) is bounded above by the denominator (`resolved_anywhere = a_only + b_only + in_both`)."
strategy   = "LTE over Nat with plusCommutative + lteAddRight; gives the [0, 1] bound on the rational ratio."
discharge  = "src/abi/Phase3AbsoluteZero.idr#inBothBoundedByResolved"
buys       = "every bridge-fidelity score the cross-repo probe emits is in [0, 1] by construction; downstream consumers can rely on it without re-validating."

[[claim]]
id         = "P3-F2"
kind       = "formal"
statement  = "`isNameBridge` characterises the EchoCNOBridge finding: in_both = 0 ∧ (a_only > 0 ∨ b_only > 0) → True."
strategy   = "case analysis on inBoth and the (aOnly, bOnly) pair."
discharge  = "src/abi/Phase3AbsoluteZero.idr#isNameBridge, emptyIsNotNameBridge, echoCNOBridgeIsNameBridge"
buys       = "the framework's classification of EchoCNOBridge as a name-bridge is decidable, not a heuristic — same predicate runs over any future bridge file."

