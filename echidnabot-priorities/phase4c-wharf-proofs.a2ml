buys       = "the declared `StateConfig` contract is sound; an implementation respecting it can hit byte-exact T-N recovery."

[[claim]]
id         = "P4c-E2"
kind       = "empirical"
statement  = "`fn snapshot/restore/recover/create_snapshot` are not yet defined in project-wharf source — implementation-presence = 0."
